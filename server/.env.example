# Copy to .env and fill in. .env is git-ignored.

# --- Oracle Database connection -------------------------------------------
# connectString is  host:port/service_name  (Easy Connect syntax).
# Examples:
#   localhost:1521/XEPDB1        (Oracle XE 21c default pluggable DB)
#   192.168.1.50:1521/ORCLPDB1
#   dbserver.example.com:1521/PROD
ORACLE_USER=nox_pos
ORACLE_PASSWORD=change-me
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# --- API server ----------------------------------------------------------
PORT=3001
# Comma-separated list of allowed browser origins (the POS dev/preview URLs).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
